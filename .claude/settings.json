{
  "permissions": {
    "deny": [
      "Read(./package-lock.json)",
      "Read(./.next/**)",
      "Read(./.open-next/**)",
      "Read(./.wrangler/**)",
      "Read(./coverage/**)",
      "Read(./public/**)",
      "Read(./next-env.d.ts)",
      "Read(./types/routes.d.ts)",
      "Read(./types/cache-life.d.ts)",
      "Read(./types/validator.ts)",
      "Read(./.env.local)",
      "Read(./.dev.vars)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
